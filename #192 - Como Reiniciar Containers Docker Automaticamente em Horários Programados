services:
  container-restarter:
    container_name: container-restarter
    image: docker:cli
    restart: unless-stopped

    environment:
      a: "10800"
      b: "21600"
      a1: "zigbee2mqtt"
      b1: "mosquitto"

    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

    entrypoint:
      - /bin/sh
      - -c

    command:
      - |
        reiniciar_grupo() {
          intervalo="$$1"
          containers="$$2"

          while true; do
            sleep "$$intervalo"

            for container in $$containers; do
              docker container restart "$$container"
            done
          done
        }

        reiniciar_grupo "$$a" "$$a1" &
        reiniciar_grupo "$$b" "$$b1" &

        wait
