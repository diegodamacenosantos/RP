<template>
 <div class="paperos paperos-q">
  <fieldset class="paperos-frame paperos-frame--acao"><legend>start</legend>
    <button class="paperos-alvo" type="button" :disabled="isProcessing" :aria-label="isProcessing ? 'Ventilador: comando em andamento' : 'Ventilador: enviar comando ON'" @click="acionar">
      <span class="paperos-estado" aria-hidden="true">{{ isProcessing ? '0' : '|' }}</span>
    </button>
  </fieldset>
 </div>
</template>

<script>
export default {
    data() {
        return { isProcessing: false, timer: null };
    },
    beforeUnmount() {
        if (this.timer) clearTimeout(this.timer);
    },
    methods: {
        acionar() {
            if (this.isProcessing) return;
            this.isProcessing = true;
            this.send({ payload: 'ON' });
            this.timer = setTimeout(() => {
                this.isProcessing = false;
                this.timer = null;
            }, 1000);
        }
    }
};
</script>

