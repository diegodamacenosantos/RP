<template>
 <div class="paperos">
  <fieldset class="paperos-frame paperos-frame--acao"><legend>Sala</legend>
    <button class="paperos-alvo" type="button" :aria-pressed="recebido ? isActive : null" :aria-label="`Quarto: ${recebido ? (isActive ? 'ligado' : 'desligado') : 'estado desconhecido'}`" @click="alternar">
      <span class="paperos-estado" aria-hidden="true">{{ recebido ? (isActive ? '0' : '|') : '?' }}</span>
    </button>
  </fieldset>
 </div>
</template>

<script>
export default {
    data() {
        return { isActive: false, recebido: false, onWidgetLoad: null, onMsgInput: null };
    },
    mounted() {
        this.onWidgetLoad = (mensagem) => this.aplicarMensagem(mensagem);
        this.onMsgInput = (mensagem) => this.aplicarMensagem(mensagem);
        this.$socket.on('widget-load:' + this.id, this.onWidgetLoad);
        this.$socket.on('msg-input:' + this.id, this.onMsgInput);
    },
    beforeUnmount() {
        if (this.onWidgetLoad) this.$socket.off('widget-load:' + this.id, this.onWidgetLoad);
        if (this.onMsgInput) this.$socket.off('msg-input:' + this.id, this.onMsgInput);
    },
    methods: {
        alternar() {
            this.isActive = !this.isActive;
            this.recebido = true;
            this.send({ payload: this.isActive ? 'ON' : 'OFF' });
        },
        aplicarMensagem(mensagem) {
            const estado = mensagem?.payload;
            if (estado === 'ON' || estado === 'OFF') {
                this.isActive = estado === 'ON';
                this.recebido = true;
            }
        }
    },
    watch: {
        msg: {
            handler() { this.aplicarMensagem(this.msg); },
            immediate: true,
            deep: true
        }
    }
};
</script>

