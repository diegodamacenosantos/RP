        "format": "<template>\n  <select v-model=\"escolhida\" @change=\"aplicar\" aria-label=\"cor do fundo\">\n    <option v-for=\"c in cores\" :key=\"c.nome\" :value=\"c.nome\">{{ c.nome }}</option>\n  </select>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      escolhida: 'bege',\n      /* TROCAR AQUI: cada linha e uma opcao. nome = texto da lista, papel = cor do fundo, tinta = cor do texto (R,G,B de 0 a 255) */\n      cores: [\n        { nome: 'bege', papel: '242,234,216', tinta: '23,21,18' },\n        { nome: 'branco', papel: '255,255,255', tinta: '23,21,18' },\n        { nome: 'cinza', papel: '224,224,224', tinta: '23,21,18' },\n        { nome: 'amarelo', papel: '250,240,190', tinta: '23,21,18' },\n        { nome: 'preto', papel: '23,21,18', tinta: '242,234,216' }\n      ]\n    }\n  },\n  mounted() {\n    try { this.escolhida = localStorage.getItem('paperos-fundo') || this.escolhida } catch (e) {}\n    this.aplicar()\n    this.$nextTick(() => { const p = document.querySelector('.nrdb-ui-page'); if (p) p.prepend(this.$el) })\n  },\n  methods: {\n    aplicar() {\n      const c = this.cores.find(x => x.nome === this.escolhida) || this.cores[0]\n      const r = document.documentElement.style\n      r.setProperty('--paperos-paper-rgb', c.papel)\n      r.setProperty('--paperos-ink-rgb', c.tinta)\n      try { localStorage.setItem('paperos-fundo', c.nome) } catch (e) {}\n    }\n  }\n}\n</script>\n\n<style>\nselect[aria-label=\"cor do fundo\"] {\n  font-family: var(--paperos-font);\n  font-size: 16px;\n  color: var(--paperos-ink);\n  background: var(--paperos-paper);\n  border: var(--paperos-border) solid var(--paperos-ink);\n  border-radius: 0;\n  padding: 6px 8px;\n  position: fixed;\n  bottom: 16px;\n  right: 16px;\n  z-index: 1000;\n  text-transform: uppercase;\n  text-align: center;\n  text-align-last: center;\n}\n</style>",
