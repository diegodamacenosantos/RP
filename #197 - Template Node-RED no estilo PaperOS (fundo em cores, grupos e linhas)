        "format": ":root {\n  /* TROCAR AQUI: cor do papel (fundo), formato R,G,B de 0 a 255. Atual: bege */\n  --paperos-paper-rgb: 242,234,216;\n  /* TROCAR AQUI: cor da tinta (texto e bordas), formato R,G,B de 0 a 255. Atual: quase preto */\n  --paperos-ink-rgb: 23,21,18;\n  /* NAO MEXER: derivadas das duas cores acima */\n  --paperos-paper: rgb(var(--paperos-paper-rgb));\n  --paperos-ink: rgb(var(--paperos-ink-rgb));\n  /* TROCAR AQUI: fonte de todo o dashboard (lista por ordem de preferencia) */\n  --paperos-font: ui-monospace, Consolas, 'Courier New', monospace;\n  /* TROCAR AQUI: espaco entre widgets. Maior = mais afastados */\n  --paperos-gap: 8px;\n  /* TROCAR AQUI: espessura da borda dos grupos. 0px = sem borda */\n  --paperos-border: 1px;\n  /* TROCAR AQUI: espessura do contorno ao navegar por teclado */\n  --paperos-focus: 2px;\n  /* TROCAR AQUI: tamanho do titulo dos grupos (minimo, ideal, maximo) */\n  --paperos-title-size: clamp(15px, 4.5vw, 18px);\n  /* TROCAR AQUI: respiro interno dos grupos. Maior = mais espaco */\n  --paperos-pad: clamp(8px, 1vw, 10px);\n  /* TROCAR AQUI: respiro menor, abaixo do titulo do grupo */\n  --paperos-pad-small: clamp(4px, .6vw, 6px);\n}\n\n:root, body { color-scheme: light !important; background: var(--paperos-paper) !important; }\n\n.v-application, .v-main, .v-app-bar, .v-navigation-drawer, .v-card { transition: none !important; }\n\n.v-theme--nrdb { color-scheme: light !important;\n  --v-theme-background: var(--paperos-paper-rgb) !important; --v-theme-on-background: var(--paperos-ink-rgb) !important;\n  --v-theme-surface: var(--paperos-paper-rgb) !important; --v-theme-on-surface: var(--paperos-ink-rgb) !important;\n  --v-theme-surface-light: var(--paperos-paper-rgb) !important; --v-theme-on-surface-light: var(--paperos-ink-rgb) !important;\n  --v-theme-group-background: var(--paperos-paper-rgb) !important; --v-theme-on-group-background: var(--paperos-ink-rgb) !important; --v-theme-group-outline: var(--paperos-ink-rgb) !important;\n  --v-theme-navigation-background: var(--paperos-paper-rgb) !important; --v-theme-on-navigation-background: var(--paperos-ink-rgb) !important;\n  --v-theme-primary: var(--paperos-ink-rgb) !important; --v-theme-on-primary: var(--paperos-paper-rgb) !important;\n  --v-border-color: var(--paperos-ink-rgb) !important; --v-border-opacity: 1 !important; --v-high-emphasis-opacity: 1 !important; --v-medium-emphasis-opacity: 1 !important; }\n\n.v-application { --group-border-radius: 0px !important; --widget-gap: var(--paperos-gap) !important; }\n\n.v-application, .v-main, .v-app-bar.v-toolbar, .v-navigation-drawer { color: var(--paperos-ink) !important; background: var(--paperos-paper) !important; font-family: var(--paperos-font) !important; box-shadow: none !important; }\n.v-toolbar-title, .v-list-item-title { font-family: var(--paperos-font) !important; font-weight: 700 !important; }\n\n.v-btn__overlay, .v-list-item__overlay, .v-card__overlay, .v-ripple__container { display: none !important; }\n:focus-visible { outline: var(--paperos-focus) solid var(--paperos-ink) !important; outline-offset: 2px; }\n\n.nrdb-ui-group > .v-card { background: var(--paperos-paper) !important; border: var(--paperos-border) solid var(--paperos-ink) !important; border-radius: 0 !important; box-shadow: none !important; }\n.nrdb-ui-group .v-card-item { padding: var(--paperos-pad) var(--paperos-pad) var(--paperos-pad-small) !important; }\n.nrdb-ui-group .v-card-title { padding: 0 !important; font-family: var(--paperos-font) !important; font-size: var(--paperos-title-size) !important; font-weight: 700 !important; line-height: 1.2 !important; white-space: normal !important; overflow: visible !important; text-overflow: clip !important; }\n.nrdb-ui-group .v-card-text { padding: 0 var(--paperos-pad) var(--paperos-pad) !important; }",
