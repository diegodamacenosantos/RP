<template>
 <div class="paperos paperos-q">
  <fieldset class="paperos-frame paperos-frame--acao"><legend>H.Marcada</legend>
    <button ref="alvo" class="paperos-alvo" type="button" :aria-label="`Configurar externa. Estado: ${recebido ? (isActive ? 'ligada' : 'desligada') : 'desconhecido'}`" @click="abrirConfiguracao">
      <span class="paperos-estado" aria-hidden="true">{{ recebido ? (isActive ? '0' : '|') : '?' }}</span>
      <span v-if="status === 'contando' && marcacao" class="paperos-detalhe" aria-hidden="true">{{ marcacao }}</span>
    </button>
    <teleport to="body"><div v-if="configurando" class="paperos-popup" role="dialog" aria-modal="true" aria-label="Configuração da externa" @click.self="fecharConfiguracao" @keydown.esc="fecharConfiguracao">
      <section ref="caixa" class="paperos-caixa" tabindex="-1">
        <strong>Externa</strong>
        <div class="paperos-linha"><button type="button" @click="definirEstado('ON')">Ligar</button><button type="button" @click="definirEstado('OFF')">Desligar</button></div>
        <label>Horário<input v-model="marcacao" type="time" @input="selecionarHorario"></label>
        <button type="button" @click="fecharConfiguracao">[ Fechar ]</button>
      </section>
    </div></teleport>
  </fieldset>
 </div>
</template>

<script>
export default {
    data() { return { value: 'OFF', status: 'parado', marcacao: '', timer: null, configurando: false, recebido: false, onWidgetLoad: null, onMsgInput: null }; },
    computed: { isActive() { return this.value === 'ON'; } },
    mounted() {
        this.onWidgetLoad = (m) => this.aplicarMensagem(m);
        this.onMsgInput = (m) => this.aplicarMensagem(m);
        this.$socket.on('widget-load:' + this.id, this.onWidgetLoad);
        this.$socket.on('msg-input:' + this.id, this.onMsgInput);
    },
    beforeUnmount() {
        this.pararTimer();
        if (this.onWidgetLoad) this.$socket.off('widget-load:' + this.id, this.onWidgetLoad);
        if (this.onMsgInput) this.$socket.off('msg-input:' + this.id, this.onMsgInput);
    },
    methods: {
        abrirConfiguracao() { this.configurando = true; },
        fecharConfiguracao() { this.configurando = false; },
        definirEstado(estado) {
            this.value = estado;
            this.recebido = true;
            this.marcacao = '';
            this.status = 'parado';
            this.pararTimer();
            this.enviarEstado();
            this.fecharConfiguracao();
        },
        selecionarHorario() {
            this.status = this.marcacao ? 'contando' : 'parado';
            this.pararTimer();
            if (this.status === 'contando') this.verificarHorario();
        },
        verificarHorario() {
            if (this.status !== 'contando' || !this.marcacao) return;
            const agora = new Date();
            const horario = `${String(agora.getHours()).padStart(2, '0')}:${String(agora.getMinutes()).padStart(2, '0')}`;
            if (horario === this.marcacao) {
                this.value = this.isActive ? 'OFF' : 'ON';
                this.recebido = true;
                this.status = 'parado';
                this.enviarEstado();
                return;
            }
            this.timer = setTimeout(() => this.verificarHorario(), 5000);
        },
        pararTimer() { if (this.timer) clearTimeout(this.timer); this.timer = null; },
        enviarEstado() { this.send({ payload: this.value }); },
        aplicarMensagem(m) {
            const dados = m?.payload;
            if (dados === 'ON' || dados === 'OFF') { this.value = dados; this.recebido = true; return; }
            if (!dados || typeof dados !== 'object') return;
            if (dados.value === 'ON' || dados.value === 'OFF') { this.value = dados.value; this.recebido = true; }
            if (typeof dados.marcacao === 'string') this.marcacao = dados.marcacao;
            this.status = dados.status === 'contando' ? 'contando' : 'parado';
            this.pararTimer();
            if (this.status === 'contando' && this.marcacao) this.verificarHorario();
        }
    },
    watch: {
        msg: { handler() { this.aplicarMensagem(this.msg); }, immediate: true, deep: true },
        configurando(aberto) { this.$nextTick(() => (aberto ? this.$refs.caixa : this.$refs.alvo)?.focus()); }
    }
};
</script>

